# Claude Code
.claude/worktrees

# Data — bulk / rebuildable stays local, mirrored to a PRIVATE HuggingFace
# dataset instead of git: huggingface.co/datasets/mvpeav/cbb-sim-data.
# On a new machine: scripts/hf_sync_data.py pull.
#
# data/processed/ and data/reference/ ARE tracked in git: trained models,
# lookup tables, and reference/crosswalk data are the unrecoverable state
# this repo exists to protect. Keep every tracked file under 50MB.
data/raw/**
data/hoopr/**
results/**
data/raw/**/*.parquet

# Node (if a dashboard is ever added)
node_modules/
dist/

# Notebooks
.ipynb_checkpoints/

# IDE / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# rebuildable large intermediates (never in git; rebuild from data/raw)
data/processed/possessions/
# v3 = v2 + the technical free-throw lookahead (68 MB, four seasons); rebuilt
# by scripts/build_possessions_techfix_v3.py
data/processed/possessions_v3/
# v4 = v3 + the three phantom-possession fixes (event layer v4, 2026-09-30);
# rebuilt by scripts/build_possessions_v4.py; HF key proposed in
# docs/tests/event_layer_v4_2026-09-30.md section 2
data/processed/possessions_v4/
data/processed/possessions_v4a/
# v4otc = v4 + overtime team-foul carry (scripts/build_possessions_v4otc_v1.py, 2026-10-01); 68 MB
data/processed/possessions_v4otc/
# clock round 6 arm artifacts (48-66 MB each; scripts/exp_clk6_r6_arms_v1.py); HF: `model_artifacts` key
data/processed/models/clock/r6_*/
data/processed/models/**/design.parquet
data/processed/models/**/*_design.parquet

# Engine S1 artifact schedules: one fitted model per monthly refit per
# population, ~47MB per (fold, season) and growing with every sub-model that
# adopts S1. Rebuildable by scripts/build_engine_event_round2.py and synced to
# the private HF dataset via scripts/hf_sync_data.py (PM decision 2026-09-10).
data/processed/models/engine/event_round2_s1_*/

# Possession-outcome round-5 ship-gate ARM artifacts (`ENGINE_EVENT=round4b_G2`
# / `round4b_G3`, default-off): the same S1 schedule shape as the served
# directory above, ~47MB per arm per (fold, season). Rebuildable by
# scripts/build_engine_event_round4b.py from round4/design_v4.parquet and
# synced under the `engine_inputs` bulk key (CLAUDE.md >20MB model-artifact
# rule; experiments.md section 12).
data/processed/models/engine/event_round4b_*/

# fg_make round-2 bake-off artifacts (grid checkpoints + fitted boosters,
# ~21-25MB each): rebuildable, gitignored, synced to the private HF dataset
# via `scripts/hf_sync_data.py --dirs model_artifacts` (PM decision
# 2026-09-10; see docs/ops/aws_launch_chain.md).
data/processed/models/fg_make/round2/
data/processed/models/fg_make/round2b/

# General pattern for future round-N / S1 bake-off artifact sets under any
# model dir, same rationale as above (rebuildable, synced via
# `model_artifacts`). Narrowed with negations rather than left as a bare
# wildcard: `git ls-files` (2026-09-10) shows
# data/processed/models/possession_outcome/round2/ and
# data/processed/models/clock/v3b_s1/ are already git-tracked, so those two
# dirs are carved back out to stay tracked and not silently drop out of
# future `git add`.
data/processed/models/*/round*/
data/processed/models/*/*_s1/
!data/processed/models/possession_outcome/round2/
!data/processed/models/clock/v3b_s1/
data/processed/models/usage_v2/
data/processed/models/usage_s1/
# usage round 3 (2026-09-11): score_diff state-feature fix event/design caches
# and the LightGBM tree boosters for the Decision-10 closed-loop gate.
# Rebuildable from scripts/train_usage_v3*.py; see experiments.md section 10-11.
data/processed/models/usage_v3/

# fg_make rounds 3-4 (2026-09-10): the shot_shooter_id event/design caches and
# the corrected engine-input sibling. All rebuildable from
# scripts/train_fg_make_v3_shooter.py, scripts/train_fg_make_v4_shooter_block.py
# and scripts/build_engine_inputs_shotshooter.py; 25-90MB each, so they follow
# the >20MB model-artifact rule in CLAUDE.md and sync via hf_sync_data.py.
data/processed/models/**/design_*.parquet
data/processed/models/fg_make/events_v2_shotshooter.parquet
data/processed/models/engine_fgm4/

# clock round 4 (docs/models/clock/experiments.md section 14): fitted schedules,
# diagnosis cell tables and the v4_diag dumps. Bulk, HF-synced, never committed.
data/processed/models/clock/v4_*
data/processed/models/free_throw/s1_confirm/
data/processed/models/free_throw/s1_scorediff/
data/processed/models/rebound/s1_confirm/
logs/

# Full-retrain chain (lane D, 2026-09-30): every stage's outputs per tag, model artifacts well
# over 20 MB; rebuildable by scripts/chain_full_retrain_v1.py; HF key proposed in
# docs/ops/full_retrain_chain_2026-09-30.md
data/processed/models/full_retrain_v1/

# L7 late-game round 1 (2026-09-18): the event-half design (85 MB) and the
# per-cell prediction / PMF dumps are model artifacts well over the 20 MB bar,
# so they are gitignored and go to the HF dataset, per CLAUDE.md data rules.
data/processed/models/late_game/
# clock round 8 arm K2 (49 MB per fold; scripts/train_clock_r8_chance_v1.py, 75 s to rebuild); HF: `model_artifacts` key
data/processed/models/clock/r8_K2/F1/
data/processed/models/clock/r8_K2/F2/
data/processed/models/clock/r8_K2/F2_seed*/
